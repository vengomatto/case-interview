{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "host",
    "components"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z]([-a-z0-9]{0,40}[a-z0-9])?$"
    },
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]([-a-z0-9]{0,30}[a-z0-9])?$",
        "not": {
          "const": "db"
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image",
          "tag",
          "port"
        ],
        "properties": {
          "image": {
            "type": "string",
            "pattern": "^[a-z0-9./_-]+$"
          },
          "tag": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$",
            "not": {
              "const": "latest"
            }
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "path": {
            "type": "string",
            "pattern": "^/([a-z0-9_-]+(/[a-z0-9_-]+)*)?$"
          },
          "health": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9/_.-]*$"
          },
          "replicas": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "resources": {
            "type": "object"
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]*$"
        },
        "user": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]*$"
        },
        "password": {
          "type": "string"
        },
        "storage": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi)$"
        }
      }
    },
    "smoke": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "path",
          "contains"
        ],
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^[a-z]([-a-z0-9]{0,30}[a-z0-9])?$"
          },
          "path": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9/_.?=&-]*$"
          },
          "contains": {
            "type": "string"
          }
        }
      }
    }
  }
}
